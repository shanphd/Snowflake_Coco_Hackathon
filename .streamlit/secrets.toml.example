# Snowflake connection configuration for Streamlit Community Cloud
# Copy this file to secrets.toml and fill in your credentials
# On Community Cloud, add these in the app settings > Secrets

[connections.snowflake]
account = "DTCC-MYYOLO"
user = "your_username"
password = "your_password"
warehouse = "SHAN_WH"
database = "SFK_HACKATHON"
schema = "SFK_HACK_1"
role = "ACCOUNTADMIN"
